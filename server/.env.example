# ─────────────────────────────────────────────────────────────────────────────
# Finpath backend — пример окружения.
# Скопируйте в .env и подставьте реальные значения: `cp .env.example .env`
# Файл .env в репозиторий не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# Порт HTTP-сервера. 4400, а не привычные 3000, — чтобы Finpath можно было
# держать поднятым одновременно с другими локальными проектами.
PORT=4400

# Разрешённые источники для CORS через запятую; `*` — любой.
# Дашборд открывается как статический файл или с другого порта, поэтому
# в деве проще оставить `*`, а в проде указать конкретный домен.
CORS_ORIGIN=*

# Строка подключения к PostgreSQL.
# ВАЖНО: база может быть общей с другими проектами, поэтому все таблицы
# Finpath имеют префикс finpath_ (см. prisma/schema.prisma).
DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/БАЗА?sslmode=require

# Секрет подписи JWT, не короче 32 символов.
# Сгенерировать: npm run keygen
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_КОРОЧЕ_32_СИМВОЛОВ

# Срок жизни токена в формате пакета `ms`: 15m, 24h, 7d.
JWT_EXPIRES_IN=7d
